# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/photon

# S3-compatible object storage (R2 / S3 / local MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=photon-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# CDN / delivery
# Signed-URL enforcement is per-org now (orgs.requires_signed_urls / orgs.url_sign_key),
# not a global toggle — see packages/db/src/seed.ts for how a dev org's key gets set.
CDN_BASE_URL=http://localhost:8788

# Ports
API_PORT=8787
DELIVERY_PORT=8788
DASHBOARD_PORT=3000

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/img

# S3-compatible object storage (R2 / S3 / local MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=img-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# CDN / delivery
CDN_BASE_URL=http://localhost:8788
DELIVERY_REQUIRE_SIGNED_URLS=false
DELIVERY_SIGNING_KEY=

# Ports
API_PORT=8787
DELIVERY_PORT=8788
DASHBOARD_PORT=3000
